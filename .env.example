# ---- dot: who it works for, and how it reaches you -------------------------
DOTS_DB=./data/dots.db

# Any OpenAI-compatible endpoint. Defaults point at a local opencode-go proxy.
DOTS_BASE_URL=http://127.0.0.1:8787/v1
DOTS_API_KEY=local
DOTS_MODEL=zen/space-bunny-free

# ---- daemon ---------------------------------------------------------------
DOTS_TICK_MS=30000
DOTS_STALE_MS=900000

# ---- proactive delivery (optional) ---------------------------------------
# Where the dot speaks first: Slack webhook, Telegram bot, anything that takes JSON.
# DOTS_WEBHOOK_URL=https://hooks.slack.com/services/...
# ---- database ------------------------------------------------------------
# Defaults to ./data/dots.db inside the container. Uncomment to keep the
# database on a host path instead of the named volume.
# DOTS_DB=/var/lib/dots/dots.db
